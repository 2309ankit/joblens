JOBLENS_DB_URL=jdbc:postgresql://localhost:5432/joblens
JOBLENS_DB_NAME=joblens
JOBLENS_DB_PORT=5432
JOBLENS_DB_USERNAME=joblens
JOBLENS_DB_PASSWORD=joblens-local

# Obtain personal-research API credentials from https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_MAX_DAYS_OLD=30

# Obtain a Singapore regional API key from https://sg.jooble.org/api/about
JOOBLE_API_KEY=
JOOBLE_COUNTRY_CODE=sg

# Optional NVIDIA open-source model scoring through Nebius Token Factory. Select NEBIUS_MODEL from
# the current Token Factory model catalogue; no potentially stale model identifier is assumed.
JOBLENS_NVIDIA_RANKING_ENABLED=false
NEBIUS_API_KEY=
NEBIUS_MODEL=
NEBIUS_MAX_JOBS_PER_RUN=25
NEBIUS_MAX_CALLS_PER_DAY=200
